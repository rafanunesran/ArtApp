<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Abrir PSDs e projetos de outras pastas (Downloads, Drive...). O app pede o acesso só
         quando a pessoa toca em "Permitir acesso" no diálogo Abrir. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Menu › Atualizar app: baixa o APK da última release e pede ao Android para instalar.
         A pessoa libera "Instalar apps desconhecidos" para o ArtApp uma vez. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:hasCode="true"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/ArtAppTheme">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density|smallestScreenSize|navigation|touchscreen|fontScale|layoutDirection|locale|colorMode|fontWeightAdjustment|mcc|mnc"
            android:windowSoftInputMode="adjustResize">
            <!-- O carregador (crates/artapp-boot) abre a libartapp.so do APK ou uma atualização
                 rápida baixada para a pasta do app. -->
            <meta-data android:name="android.app.lib_name" android:value="artapp_boot" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Escolher a pasta de backup (seletor do Android, inclusive Google Drive). -->
        <activity
            android:name=".FolderPicker"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Reabre o app depois de uma atualização rápida (Restart.java), num processo à parte. -->
        <activity
            android:name=".Restart"
            android:exported="false"
            android:process=":restart"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Menu › Compartilhar: entrega a imagem ao app escolhido, só leitura (Share.java). -->
        <provider
            android:name=".Share"
            android:authorities="io.github.rafanunesran.artapp.share"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Resultado da instalação da atualização (Updater.java). -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />
    </application>
</manifest>
